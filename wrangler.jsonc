{
  // The download page as a Worker whose only job is serving static files.
  //
  // Deployed by Cloudflare's Git integration: the dashboard's deploy command is
  // `npx wrangler deploy`, and this file is what that command reads.
  //
  // `name` must match the Worker name in the dashboard, or wrangler would create a second
  // Worker instead of updating this one.
  "name": "drink-quick-cal",

  // The one small script this Worker runs. Everything else stays static: Cloudflare serves an
  // asset whenever one matches, and the script is reached only for paths no asset matched — which
  // is exactly the single route in it. So the page is as cheap and fast as before.
  "main": "./cloudflare/download-page.js",

  // Cloudflare's own example sets this to today's date; it is the date from which runtime
  // behaviour is fixed. With no Worker script there is no runtime behaviour to pin, but
  // wrangler expects the field.
  "compatibility_date": "2026-11-12",

  // The workers.dev address stays on. It is a working URL even if the custom domain (or its
  // DNS) has a bad day, and it is what the first deploy reported. Set false to serve only
  // through the custom domain.
  "workers_dev": true,

  // Preview URLs are OFF on purpose. Left implicit, every deployed version becomes reachable at
  // its own permanent URL — and for a page whose entire job is telling a shop WHICH build to
  // install, a stale copy staying online is the one thing it must not have. Set true when
  // per-branch previews are genuinely wanted.
  "preview_urls": false,

  // `download-page/` is the whole site: index.html, logo.png, and Cloudflare's two config files
  // (_headers, _redirects) which it reads rather than serves. Nothing else belongs in that
  // directory — every file in it gets a public URL.
  "assets": {
    "directory": "./download-page",
    "binding": "ASSETS"
  },

  // Where the installation file is kept. The script streams it, so a shop downloads from this
  // domain and never sees this address — which is the whole point of the route.
  "vars": {
    "APK_UPSTREAM": "https://github.com/mdksako-eng/Drink_Quick_Cal/releases/download/v1.1.0/app-release.apk"
  }
}
