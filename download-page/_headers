# Cloudflare Pages headers for the download page.
#
# The backend now sends helmet's headers; a static host sends none unless told to, and this
# page is the front door for new users, so the same class of protection belongs here.
#
# CSP note: 'unsafe-inline' is required because the page carries its CSS and JS inline, which
# is the same reason the backend deliberately left CSP off for its public pages. Pinning
# connect-src to the API host is the part that still earns its keep: without it, a stray
# script could post the page's data anywhere it liked.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src https://drink-quick-cal-kja1.onrender.com; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# The logo never changes between releases, so let the CDN keep it.
/logo.png
  Cache-Control: public, max-age=604800
